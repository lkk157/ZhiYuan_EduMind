# ===== 数据库（MySQL 8.x，事实源）=====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DB=zhiyuan

# ===== JWT 鉴权（多端登录，核心表绑定 user_id）=====
# JWT_SECRET 务必改成 32 位以上随机字符串，答辩机与部署机各自独立
JWT_SECRET=change_me_random_32chars
JWT_EXPIRE_MINUTES=1440

# ===== Ollama（全部本地推理，8G 显存串行化）=====
# 模型名以 `ollama list` 输出的 NAME 为准（不要凭印象写短名）
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
# 视觉/OCR 模型（定为 GLM-OCR：2.2GB 轻量 OCR 专精，8G 显存下加载/卸载压力小）
# 若 ollama pull glm-ocr 失败，fallback：deepseek-ocr（6.7GB）→ qwen2.5-vl:3b
# （仅需改本行，代码不写死模型名）
OCR_MODEL=glm-ocr
EMBED_MODEL=qwen3-embedding:0.6b
# 显存策略：LLM 热点驻留 / Embedding 短驻留 / OCR 用完即卸（红线，见 CLAUDE.md）
LLM_KEEP_ALIVE=10m
OCR_KEEP_ALIVE=0
LLM_NUM_CTX=4096

# ===== RAG 参数（阈值在 M2 验收用正负例标定后回填）=====
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=5
SCORE_THRESHOLD=0.35

# ===== Agent 多轮（M4）：query 改写的滑窗条数（最近 N 条 ≈ N/2 轮）=====
SHORT_TERM_WINDOW=6
# 分工具检索条数（出题聚焦 / 总结更全；检索池取与 TOP_K 的最大值）
TOP_K_QUIZ=5
TOP_K_SUMMARY=7

# ===== RAG 质量包：混合检索（vector=纯向量基线 / hybrid=BM25+向量融合）=====
RETRIEVAL_MODE=vector
# BM25 准入下限（与 SCORE_THRESHOLD 双闸并行；标定脚本按正负例分布回填）
BM25_FLOOR=2.0

# ===== M5 长效记忆：注入答疑 prompt 的学情背景条数上限 =====
MEMORY_TOP_K=5

# ===== 上传限制（产品需求：单批最多 5 个文件、总大小 ≤200MB）=====
MAX_UPLOAD_FILES=5
MAX_UPLOAD_TOTAL_MB=200

# ===== 路径 =====
UPLOAD_DIR=data/uploads
CHROMA_DIR=data/chroma
LOG_DIR=logs
